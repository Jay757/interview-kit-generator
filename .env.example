# Trao Monorepo Environment Variables Template
# Copy this file to .env or apps/api/.env before starting

# Port for the Express API server (default: 4000)
PORT=4000

# MongoDB connection URI for persistent kits and sessions
MONGODB_URI=mongodb://127.0.0.1:27017/trao_dev

# Allowed frontend origin for CORS credentials
CORS_ORIGIN=http://localhost:3000

# Secret key used to sign Express session cookies (minimum 32 chars)
SESSION_SECRET=trao-dev-session-secret-key-32-chars-minimum

# Name of the HTTP session cookie
SESSION_COOKIE_NAME=trao_session

# LLM API Key (OpenRouter or compatible provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Model identifier (default: google/gemini-2.5-flash or openrouter/free)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Allow local IP/localhost fetching for test harness (set to true during testing/batch evaluation)
ALLOW_LOCAL_FETCH=false

# Optional Tavily API key for live search of public interview discussions
TAVILY_API_KEY=

# Public API URL for web frontend (used in apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
