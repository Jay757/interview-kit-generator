# Port for the Express API server to listen on
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/trao_dev

# Allowed origin for CORS requests from the web frontend
CORS_ORIGIN=http://localhost:3000

# Secret key used to sign session cookies
SESSION_SECRET=trao-dev-session-secret-key-32-chars-minimum

# Name of the HTTP session cookie
SESSION_COOKIE_NAME=trao_session

# LLM Provider Configuration (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional Search API for public discussion retrieval
TAVILY_API_KEY=

# Allow local IP/localhost fetching for test harness (set to true during testing/batch evaluation)
ALLOW_LOCAL_FETCH=false

