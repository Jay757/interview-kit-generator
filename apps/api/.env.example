# Port for the Express API server to listen on
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/trao_dev

# Allowed origin for CORS requests from the web frontend
CORS_ORIGIN=http://localhost:3000

# Secret key used to sign session cookies
SESSION_SECRET=trao-dev-session-secret-key-32-chars-minimum

# Name of the HTTP session cookie
SESSION_COOKIE_NAME=trao_session
